# =============================================================================
# ALODILA-PMS — Auth promote environment (LOCAL / approved CLONE only)
# =============================================================================
# Copy to .env.auth and load before running auth-promote.local.mjs:
#   set -a && source rls-validation/release/.env.auth && set +a   # bash
#   # PowerShell: $env:SUPABASE_URL="..."; $env:SERVICE_ROLE_KEY="..."
#
# NEVER commit .env.auth. NEVER use Production credentials here.
# Production project ref (BLOCKED by promote script): ryfqqyrqmsyngwcsfjug
# =============================================================================

# Local Supabase (from `supabase status` — default API port 54321)
SUPABASE_URL=http://127.0.0.1:54321

# Service role key from `supabase status` (local) or approved clone Dashboard → API
# This is NOT your database password and NOT the anon key.
SERVICE_ROLE_KEY=your-local-service-role-key-here

# Optional: allow promote against an approved non-localhost clone URL.
# Production ref ryfqqyrqmsyngwcsfjug is STILL refused when this is set.
# ALLOW_NON_LOCAL_AUTH_PROMOTE=YES

# Example approved clone URL (uncomment only for Gate A clone — NOT production):
# SUPABASE_URL=https://your-clone-project-ref.supabase.co
# ALLOW_NON_LOCAL_AUTH_PROMOTE=YES
