{
  "name": "alodila-pms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "rls:validate": "node rls-validation/scripts/run.mjs",
    "rls:detect": "node rls-validation/scripts/detect.mjs",
    "local:start": "supabase start",
    "local:stop": "supabase stop",
    "local:status": "supabase status",
    "local:reset": "supabase db reset --yes",
    "local:validate": "node rls-validation/scripts/local-validate.mjs",
    "release:preflight": "node rls-validation/scripts/release-preflight.mjs",
    "release:smoke": "node rls-validation/scripts/clone-smoke.mjs",
    "release:closeout": "node rls-validation/scripts/release-preflight.mjs && node rls-validation/scripts/clone-smoke.mjs",
    "auth:promote:dry": "node rls-validation/release/auth-promote.local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.102.1",
    "i18next": "^26.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
